#pragma kernel Simulate
#pragma kernel ApplyImpact
#pragma kernel CheckActivity
#pragma kernel ResetTargets
#pragma kernel ApplyFingertip

// Buffers
StructuredBuffer<float3> _Rest;
RWStructuredBuffer<float3> _Target;
RWStructuredBuffer<float3> _Pos;
RWStructuredBuffer<float3> _Vel;
RWStructuredBuffer<uint> _ActiveFlag;
StructuredBuffer<float> _BoundaryWeights;
uint _VertexCount;
uint _UseBoundaryMask;

// Impact / fingertip params (shared uniforms)
float3 _ImpactPointLS;
float3 _PushDirLS;
float3 _AbsScale;
float _Dent;
float _Kick;
float _MaxDistanceWS;

// Spring params
float _DT;
float _SpringK;
float _Damping;


// ── Existing kernels (unchanged) ─────────────────────────────────────────────

[numthreads(256, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _VertexCount)
        return;

    float3 x  = _Pos[i];
    float3 xT = _Target[i];
    float3 v  = _Vel[i];

    // F = -k(x - x0) - c·v
    float3 springForce  = -_SpringK * (x - xT);
    float3 dampingForce = -_Damping * v;

    float3 a = springForce + dampingForce;

    // Semi-implicit Euler
    v += a * _DT;
    x += v * _DT;

    _Vel[i] = v;
    _Pos[i] = x;
}

[numthreads(256, 1, 1)]
void ApplyImpact(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _VertexCount)
        return;

    float3 xLS = _Pos[i];

    float3 dLS   = xLS - _ImpactPointLS;
    float3 dWS   = dLS * _AbsScale;
    float distWS = length(dWS);

    if (distWS > _MaxDistanceWS)
        return;

    float t = saturate(distWS / _MaxDistanceWS);
    float w = 1.0 - t;
    w = w * w * (3.0 - 2.0 * w); // smoothstep

    float3 pushDirLS = normalize(_PushDirLS);
    float  bw        = _UseBoundaryMask ? _BoundaryWeights[i] : 1.0;

    _Target[i] -= pushDirLS * (_Dent * w * bw);
    _Vel[i]    -= pushDirLS * (_Kick * w * bw);
}

[numthreads(256, 1, 1)]
void CheckActivity(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _VertexCount)
        return;

    float3 v      = _Vel[i];
    float  speedSq = dot(v, v);

    if (speedSq > 0.001 * 0.001)
        InterlockedOr(_ActiveFlag[0], 1);
}


// ── New kernels for non-physics fingertip interaction ─────────────────────────

// Copies _Rest into _Target.
// Called once per FixedUpdate frame (before all ApplyFingertip dispatches) so
// that targets reset to the neutral pose automatically when fingers are absent,
// giving the spring-damper system a resting target to pull back toward.
[numthreads(256, 1, 1)]
void ResetTargets(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _VertexCount)
        return;

    _Target[i] = _Rest[i];
}

// Displaces _Target vertices within _MaxDistanceWS of _ImpactPointLS (which
// holds the fingertip position in local space for this kernel).
//
// Key differences from ApplyImpact:
//   • Distance is measured from the REST vertex, not the current deformed pos.
//     This keeps the influence radius stable as the mesh deforms.
//   • Only _Target is written; _Vel is untouched.
//     Velocity is generated organically by the spring as _Pos chases _Target,
//     so there is no need for an explicit velocity impulse per finger per frame.
[numthreads(256, 1, 1)]
void ApplyFingertip(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _VertexCount)
        return;

    float3 restLS = _Rest[i];
    float3 dLS    = restLS - _ImpactPointLS;
    float3 dWS    = dLS * _AbsScale;
    float distWS  = length(dWS);

    if (distWS > _MaxDistanceWS)
        return;

    float t = saturate(distWS / _MaxDistanceWS);
    float w = 1.0 - t;
    w = w * w * (3.0 - 2.0 * w); // smoothstep falloff

    float  bw        = _UseBoundaryMask ? _BoundaryWeights[i] : 1.0;
    float3 pushDirLS = normalize(_PushDirLS);

    _Target[i] -= pushDirLS * (_Dent * w * bw);
}
